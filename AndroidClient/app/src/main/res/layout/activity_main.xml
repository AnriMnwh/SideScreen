<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05080F">

    <!-- Video Surface -->
    <SurfaceView
        android:id="@+id/surfaceView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextureView
        android:id="@+id/textureView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Sleek Floating HUD Pill Badge (In-Stream Stats) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/statusBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:elevation="12dp"
        android:visibility="gone"
        app:cardCornerRadius="24dp"
        app:cardBackgroundColor="#D90F172A"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:gravity="center_vertical">

            <!-- Live Stream Dot -->
            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/status_indicator_green"
                android:layout_marginEnd="10dp" />

            <!-- FPS Chip -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginEnd="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FPS"
                    android:textColor="#94A3B8"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />
                <TextView
                    android:id="@+id/fpsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#34D399"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:typeface="monospace" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="22dp"
                android:background="#26FFFFFF"
                android:layout_marginEnd="12dp" />

            <!-- Bitrate Chip -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginEnd="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BITRATE"
                    android:textColor="#94A3B8"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />
                <TextView
                    android:id="@+id/bitrateText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#60A5FA"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:typeface="monospace" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="22dp"
                android:background="#26FFFFFF"
                android:layout_marginEnd="12dp" />

            <!-- Resolution Chip -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginEnd="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STREAM"
                    android:textColor="#94A3B8"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />
                <TextView
                    android:id="@+id/resolutionText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#F8FAFC"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:typeface="monospace" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="22dp"
                android:background="#26FFFFFF"
                android:layout_marginEnd="12dp" />

            <!-- Latency Chip: clock-synced E2E p50/p95 · decode · RTT -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/latencyLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LATENCY"
                    android:textColor="#94A3B8"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />
                <TextView
                    android:id="@+id/latencyText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#A78BFA"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:typeface="monospace" />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Floating Settings Action Pill -->
    <androidx.cardview.widget.CardView
        android:id="@+id/settingsButton"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_margin="24dp"
        android:elevation="12dp"
        android:visibility="gone"
        app:cardCornerRadius="26dp"
        app:cardBackgroundColor="#D90F172A"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_settings"
            android:tint="#F8FAFC"
            android:contentDescription="Display Settings" />
    </androidx.cardview.widget.CardView>

    <!-- Modern Material 3 Landing & Connection Panel -->
    <androidx.cardview.widget.CardView
        android:id="@+id/settingsPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:elevation="24dp"
        app:cardCornerRadius="28dp"
        app:cardBackgroundColor="#F20F172A"
        app:layout_constraintWidth_max="540dp"
        app:layout_constraintHeight_max="760dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="28dp">

                <!-- Hero Brand Header -->
                <FrameLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:background="@drawable/connection_icon_bg"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="⬒"
                        android:textColor="#34D399"
                        android:textSize="28sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Side Screen"
                    android:textColor="#F8FAFC"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02"
                    android:gravity="center"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="High-refresh second display for your Mac"
                    android:textColor="#94A3B8"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:layout_marginBottom="8dp" />

                <!-- Companion Mac Requirement Pill -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/instruction_bg"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Requires Mac companion app · "
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/getMacAppLink"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="sidescreen.dev →"
                        android:textColor="#38BDF8"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:padding="4dp"
                        android:background="?attr/selectableItemBackground" />
                </LinearLayout>

                <!-- Segmented Mode Toggle: USB / Wireless -->
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/modeToggleGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/modeUSB"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="48dp"
                        android:text="USB Cable"
                        android:textAllCaps="false"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/mode_toggle_text"
                        app:cornerRadius="14dp"
                        app:backgroundTint="@color/mode_toggle_bg"
                        app:strokeColor="#26FFFFFF"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/modeWireless"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="48dp"
                        android:text="Wireless Wi-Fi"
                        android:textAllCaps="false"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/mode_toggle_text"
                        app:cornerRadius="14dp"
                        app:backgroundTint="@color/mode_toggle_bg"
                        app:strokeColor="#26FFFFFF"
                        app:strokeWidth="1dp" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <!-- ============= USB MODE CONTENT ============= -->
                <LinearLayout
                    android:id="@+id/usbModeContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Live Status Card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:background="@drawable/instruction_bg"
                        android:layout_marginBottom="12dp">

                        <View
                            android:id="@+id/statusIndicator"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@drawable/status_indicator"
                            android:layout_marginEnd="12dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CONNECTION STATUS"
                                android:textColor="#64748B"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.08" />

                            <TextView
                                android:id="@+id/statusText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ready to connect"
                                android:textColor="#F8FAFC"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Connection Checklist Card -->
                    <LinearLayout
                        android:id="@+id/checklistContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:background="@drawable/instruction_bg"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="USB Readiness Checklist"
                            android:textColor="#F8FAFC"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="12dp" />

                        <!-- Developer Mode Check -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingTop="4dp"
                            android:paddingBottom="8dp">
                            <View
                                android:id="@+id/checkDeveloperMode"
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:background="@drawable/status_indicator_red"
                                android:layout_marginEnd="12dp" />
                            <TextView
                                android:id="@+id/textDeveloperMode"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="Developer Mode enabled"
                                android:textColor="#CBD5E1"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#14FFFFFF" />

                        <!-- USB Debugging Check -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp">
                            <View
                                android:id="@+id/checkUsbDebugging"
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:background="@drawable/status_indicator_red"
                                android:layout_marginEnd="12dp" />
                            <TextView
                                android:id="@+id/textUsbDebugging"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="USB Debugging enabled"
                                android:textColor="#CBD5E1"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#14FFFFFF" />

                        <!-- USB Connected Check -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp">
                            <View
                                android:id="@+id/checkUsbConnected"
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:background="@drawable/status_indicator_red"
                                android:layout_marginEnd="12dp" />
                            <TextView
                                android:id="@+id/textUsbConnected"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="USB cable connected"
                                android:textColor="#CBD5E1"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#14FFFFFF" />

                        <!-- Mac Server Check -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingTop="8dp"
                            android:paddingBottom="4dp">
                            <View
                                android:id="@+id/checkMacServer"
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:background="@drawable/status_indicator_red"
                                android:layout_marginEnd="12dp" />
                            <TextView
                                android:id="@+id/textMacServer"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="Mac server running"
                                android:textColor="#CBD5E1"
                                android:textSize="13sp" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- Primary Connect Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/connectButton"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Connect via USB"
                        android:textAllCaps="false"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#052E16"
                        app:cornerRadius="16dp"
                        app:backgroundTint="#34D399"
                        android:layout_marginBottom="8dp" />

                    <!-- Advanced Settings (collapsed by default) -->
                    <LinearLayout
                        android:id="@+id/advancedSettings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:background="@drawable/instruction_bg"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp"
                        android:visibility="gone">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="3"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            app:boxStrokeColor="#38BDF8"
                            app:hintTextColor="#94A3B8"
                            android:layout_marginEnd="8dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/hostInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Host"
                                android:text="127.0.0.1"
                                android:textColor="#F8FAFC"
                                android:textColorHint="#64748B"
                                android:textSize="13sp"
                                android:inputType="text" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            app:boxStrokeColor="#38BDF8"
                            app:hintTextColor="#94A3B8">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/portInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Port"
                                android:text="54321"
                                android:textColor="#F8FAFC"
                                android:textColorHint="#64748B"
                                android:textSize="13sp"
                                android:inputType="number" />
                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                    <!-- Show Advanced link -->
                    <TextView
                        android:id="@+id/showAdvanced"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Advanced Settings"
                        android:textColor="#60A5FA"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:padding="8dp"
                        android:background="?attr/selectableItemBackground" />

                </LinearLayout>
                <!-- ============= /USB MODE CONTENT ============= -->

                <!-- ============= WIRELESS MODE CONTENT ============= -->
                <LinearLayout
                    android:id="@+id/wirelessModeContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- State: Connecting (auto or after scan) -->
                    <LinearLayout
                        android:id="@+id/wirelessConnecting"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="24dp"
                        android:background="@drawable/instruction_bg"
                        android:layout_marginBottom="16dp"
                        android:visibility="gone">

                        <ProgressBar
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:indeterminateTint="#34D399"
                            android:layout_marginBottom="14dp" />

                        <TextView
                            android:id="@+id/connectingLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Connecting…"
                            android:textColor="#F8FAFC"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/connectingSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#94A3B8"
                            android:textSize="12sp"
                            android:typeface="monospace"
                            android:gravity="center" />
                    </LinearLayout>

                    <!-- State 1: First-time -->
                    <LinearLayout
                        android:id="@+id/wirelessFirstTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:background="@drawable/instruction_bg"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Pair with your Mac over Wi-Fi"
                            android:textColor="#F8FAFC"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Open Side Screen on your Mac, switch to Wireless Wi-Fi, and scan the QR code."
                            android:textColor="#94A3B8"
                            android:textSize="13sp"
                            android:gravity="center"
                            android:layout_marginBottom="18dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/wirelessScanButton"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:text="Scan QR Code"
                            android:textAllCaps="false"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:cornerRadius="16dp"
                            app:backgroundTint="#34D399"
                            android:textColor="#052E16" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/wirelessEnterCodeButton"
                            style="?attr/borderlessButtonStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="No camera? Enter 8-digit code instead"
                            android:textAllCaps="false"
                            android:textColor="#60A5FA"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- State 3: Connected -->
                    <LinearLayout
                        android:id="@+id/wirelessConnected"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:background="@drawable/instruction_bg"
                        android:layout_marginBottom="16dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="● CONNECTED"
                            android:textColor="#34D399"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08"
                            android:gravity="center"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            android:id="@+id/connectedMacName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Mac"
                            android:textColor="#F8FAFC"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/connectedMacIp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textColor="#94A3B8"
                            android:textSize="12sp"
                            android:typeface="monospace"
                            android:gravity="center"
                            android:layout_marginBottom="18dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/wirelessDisconnectButton"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="Disconnect"
                            android:textAllCaps="false"
                            android:textColor="#F8FAFC"
                            app:cornerRadius="14dp"
                            app:strokeColor="#33FFFFFF"
                            android:layout_marginBottom="8dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/wirelessForgetButton"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="Forget this Mac"
                            android:textAllCaps="false"
                            android:textColor="#FCA5A5"
                            app:cornerRadius="14dp"
                            app:strokeColor="#7F1D1D" />
                    </LinearLayout>

                    <!-- State: Paired idle (after explicit Disconnect) -->
                    <LinearLayout
                        android:id="@+id/wirelessPairedIdle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:background="@drawable/instruction_bg"
                        android:layout_marginBottom="16dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="○ PAIRED · STANDBY"
                            android:textColor="#94A3B8"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08"
                            android:gravity="center"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            android:id="@+id/idleMacName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Mac"
                            android:textColor="#F8FAFC"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/idleMacIp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textColor="#94A3B8"
                            android:textSize="12sp"
                            android:typeface="monospace"
                            android:gravity="center"
                            android:layout_marginBottom="18dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/wirelessReconnectButton"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:text="Reconnect to Mac"
                            android:textAllCaps="false"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:cornerRadius="16dp"
                            app:backgroundTint="#34D399"
                            android:textColor="#052E16"
                            android:layout_marginBottom="8dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/wirelessIdleForgetButton"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="Forget this Mac"
                            android:textAllCaps="false"
                            android:textColor="#FCA5A5"
                            app:cornerRadius="14dp"
                            app:strokeColor="#7F1D1D" />
                    </LinearLayout>

                    <!-- State 4: Token mismatch / re-pair -->
                    <LinearLayout
                        android:id="@+id/wirelessTokenMismatch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:background="@drawable/instruction_bg"
                        android:layout_marginBottom="16dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/repairTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="⚠ Couldn't connect"
                            android:textColor="#FCA5A5"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/repairMessage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Scan a fresh QR from your Mac to re-pair."
                            android:textColor="#CBD5E1"
                            android:textSize="13sp"
                            android:gravity="center"
                            android:layout_marginBottom="18dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/wirelessRescanButton"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:text="Scan QR Code"
                            android:textAllCaps="false"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:cornerRadius="16dp"
                            app:backgroundTint="#34D399"
                            android:textColor="#052E16" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/wirelessRepairEnterCodeButton"
                            style="?attr/borderlessButtonStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Enter code instead"
                            android:textAllCaps="false"
                            android:textColor="#60A5FA"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- State 5: Permission denied permanently -->
                    <LinearLayout
                        android:id="@+id/wirelessPermDenied"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:background="@drawable/instruction_bg"
                        android:layout_marginBottom="16dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Camera permission required to scan QR"
                            android:textColor="#F8FAFC"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="You blocked the permission. Open Settings → Apps → Side Screen → Permissions to allow."
                            android:textColor="#CBD5E1"
                            android:textSize="13sp"
                            android:gravity="center"
                            android:layout_marginBottom="18dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/wirelessOpenSettingsButton"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:text="Open App Settings"
                            android:textAllCaps="false"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:cornerRadius="16dp"
                            app:backgroundTint="#3B82F6" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/wirelessPermDeniedEnterCodeButton"
                            style="?attr/borderlessButtonStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="No camera? Enter code instead"
                            android:textAllCaps="false"
                            android:textColor="#60A5FA"
                            android:textSize="13sp" />
                    </LinearLayout>

                </LinearLayout>
                <!-- ============= /WIRELESS MODE CONTENT ============= -->

                <!-- Footer Quick-Explore Row (Demo & Video) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/watchVideoButton"
                        style="?attr/borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="Watch Video"
                        android:textAllCaps="false"
                        android:textColor="#94A3B8"
                        android:textSize="13sp"
                        app:cornerRadius="12dp"
                        app:backgroundTint="#0FFFFFFF" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/demoButton"
                        style="?attr/borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="Try Live Demo"
                        android:textAllCaps="false"
                        android:textColor="#38BDF8"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp"
                        app:backgroundTint="#1438BDF8" />
                </LinearLayout>

                <!-- Hidden disconnect button reference (needed by code) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/disconnectButton"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.cardview.widget.CardView>

    <!-- Hidden log text (needed by code) -->
    <TextView
        android:id="@+id/logText"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>
